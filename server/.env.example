DATABASE_URL="postgresql://ro:ro@localhost:5432/ro_simulator?schema=public"
PORT=3000

# Character-sprite preview reads straight from the game client's data.grf.
# Default: <project>/client/RagnarokClassic/data.grf (unzipped RagnarokClassic.zip).
# If the game is installed on this machine, point at it instead — no copy needed.
# The same value is used by tools/build_grf_index.py and tools/extract_assets.py.
# GRF_PATH="C:/Gravity/RagnarokClassic/data.grf"
# GRF_PATH="/Applications/RagnarokClassic/data.grf"
